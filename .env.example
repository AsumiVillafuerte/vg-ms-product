# ==========================================================
#  vg-ms-products - Variables de entorno (EJEMPLO)
#  Copia este archivo a .env y completa los valores reales.
#  NUNCA subas el .env con secretos al repositorio.
# ==========================================================

# Perfil de Spring Boot: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Puerto HTTP del microservicio
SERVER_PORT=8086

# --- Base de datos (R2DBC - aplicacion) ---
DATABASE_URL=r2dbc:postgresql://localhost:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me

# --- Pool R2DBC ---
DB_POOL_INITIAL_SIZE=2
DB_POOL_MAX_SIZE=10

# --- Contexto por defecto cuando se invoca sin JWT (seguridad deshabilitada) ---
DEFAULT_ORGANIZATION_ID=default
DEFAULT_USER_ID=system

# --- Claim del token que identifica la organizacion (tenant, solo si se envia JWT) ---
ORGANIZATION_CLAIM=organizationId
