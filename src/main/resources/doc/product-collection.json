{
  "info": {
    "_postman_id": "b7c3f9a1-2d4e-4f6a-9c1b-0e5d7a8f3b21",
    "name": "vg-ms-products",
    "description": "Coleccion de pruebas para el microservicio de productos (vg-ms-products). Requiere un token JWT de Keycloak (Bearer).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8086", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "brandId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Marcas",
      "item": [
        {
          "name": "Crear marca",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.id) { pm.collectionVariables.set('brandId', body.data.id); }",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marca de prueba\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/brands", "host": ["{{baseUrl}}"], "path": ["api", "v1", "brands"] }
          }
        },
        {
          "name": "Listar marcas",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/brands", "host": ["{{baseUrl}}"], "path": ["api", "v1", "brands"] }
          }
        },
        {
          "name": "Obtener marca por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/brands/{{brandId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "brands", "{{brandId}}"] }
          }
        },
        {
          "name": "Listar marcas por estado",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/brands/status/A", "host": ["{{baseUrl}}"], "path": ["api", "v1", "brands", "status", "A"] }
          }
        },
        {
          "name": "Actualizar marca",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marca de prueba (editada)\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/brands/{{brandId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "brands", "{{brandId}}"] }
          }
        },
        {
          "name": "Desactivar marca",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/v1/brands/{{brandId}}/deactivate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "brands", "{{brandId}}", "deactivate"] }
          }
        },
        {
          "name": "Reactivar marca",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/v1/brands/{{brandId}}/activate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "brands", "{{brandId}}", "activate"] }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.id) { pm.collectionVariables.set('productId', body.data.id); }",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commercialName\": \"Producto de prueba\",\n  \"brandId\": \"{{brandId}}\",\n  \"productType\": \"venta\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/products", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] }
          }
        },
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/products", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] }
          }
        },
        {
          "name": "Obtener producto por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products", "{{productId}}"] }
          }
        },
        {
          "name": "Listar productos por estado",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/products/status/A", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products", "status", "A"] }
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commercialName\": \"Producto de prueba (editado)\",\n  \"brandId\": \"{{brandId}}\",\n  \"productType\": \"venta\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products", "{{productId}}"] }
          }
        },
        {
          "name": "Desactivar producto",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/v1/products/{{productId}}/deactivate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products", "{{productId}}", "deactivate"] }
          }
        },
        {
          "name": "Reactivar producto",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/v1/products/{{productId}}/activate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products", "{{productId}}", "activate"] }
          }
        }
      ]
    }
  ]
}
